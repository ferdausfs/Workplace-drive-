diff --git a/app/src/main/java/neth/iecal/curbox/ui/fragments/main/reducers/guardian/GuardianFragment.kt b/app/src/main/java/neth/iecal/curbox/ui/fragments/main/reducers/guardian/GuardianFragment.kt
